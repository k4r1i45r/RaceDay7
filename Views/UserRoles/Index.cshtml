@model IEnumerable<RaceDay7.Models.ViewModels.UserRolesViewModel>
@{
    ViewData["Title"] = "User Role Management";
}

<style>
    .custom-table-header {
        background-color: #B5CBB7;
        color: #08090A;
    }

    .custom-table-row {
        background-color: #E4E9B2;
    }

    .custom-btn {
        background-color: #818479;
        color: white;
        border: none;
    }

        .custom-btn:hover {
            background-color: #D2E4C4;
            color: #08090A;
        }
</style>

<div class="container mt-4">
    <h2 style="color: #08090A;">User Role Management</h2>
    <hr />
    <table class="table table-striped table-bordered">
        <thead class="custom-table-header">
            <tr>
                <th>Email</th>
                <th>Username</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr class="custom-table-row">
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge" style="background-color: #D2E4C4; color: #08090A; margin-right: 5px;">@role</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Manage" asp-route-userId="@user.UserId" class="btn btn-sm custom-btn">Manage Roles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>