@model List<RaceDay7.Models.ViewModels.ManageUserRolesViewModel>
@{
    ViewData["Title"] = "Manage User Roles";
    var userId = ViewBag.UserId;
}

<style>
    .card-header-custom {
        background-color: #B5CBB7;
        color: #08090A;
    }

    .card-body-custom {
        background-color: #E4E9B2;
    }

    .card-footer-custom {
        background-color: #D2E4C4;
    }

    .custom-btn {
        background-color: #818479;
        color: white;
        border: none;
    }

        .custom-btn:hover {
            background-color: #08090A;
            color: white;
        }
</style>

<div class="container mt-4">
    <h2 style="color: #08090A;">Manage Role for: <strong>@ViewBag.UserName</strong></h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Manage" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@userId" />

                <div class="card">
                    <div class="card-header card-header-custom">
                        <h4>Select a role for this user</h4>
                    </div>
                    <div class="card-body card-body-custom">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <div class="form-check m-1">
                                <input type="hidden" asp-for="@Model[i].RoleId" />
                                <input type="hidden" asp-for="@Model[i].RoleName" />
                                <input asp-for="@Model[i].IsSelected" class="form-check-input" type="radio" value="true" />
                                <label class="form-check-label" style="color: #08090A;">
                                    @Model[i].RoleName
                                </label>
                            </div>
                        }
                    </div>
                    <div class="card-footer card-footer-custom">
                        <input type="submit" value="Update Role" class="btn custom-btn" />
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
