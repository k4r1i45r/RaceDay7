@model List<RaceDay7.Models.ViewModels.ManageUserRolesViewModel>
@{
    ViewData["Title"] = "Manage User Role";
    var userId = ViewBag.UserId;
}

<h1>Manage Role for @ViewBag.UserName</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Manage" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@userId" />

            <div class="card">
                <div class="card-header">
                    <h4>Select a role for this user</h4>
                </div>
                <div class="card-body">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="form-check m-1">
                            <input type="hidden" asp-for="@Model[i].RoleId" />
                            <input type="hidden" asp-for="@Model[i].RoleName" />
                            <input asp-for="@Model[i].IsSelected" class="form-check-input" type="radio" value="true" />
                            <label class="form-check-label">
                                @Model[i].RoleName
                            </label>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <input type="submit" value="Update Role" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </form>
    </div>
</div>
