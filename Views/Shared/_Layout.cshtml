<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay7</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay7.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #ffffff;
        }

        .navbar {
            background-color: #E4E9B2 !important;
            border-bottom: 2px solid #B5CBB7 !important;
        }

        .navbar-brand {
            color: #08090A !important;
            font-weight: bold;
        }

        .nav-link {
            color: #08090A !important;
        }

        .footer {
            background-color: #E4E9B2;
            border-top: 2px solid #B5CBB7 !important;
        }

        .dash-stat {
            background-color: #D2E4C4;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #B5CBB7;
        }

            .dash-stat .value {
                font-size: 2rem;
                font-weight: bold;
                color: #08090A;
            }

            .dash-stat .label {
                color: #818479;
                font-weight: 500;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RaceDay7</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a></li>
                        <!-- ADDED NAV LINKS PARTIAL HERE -->
                        <partial name="_NavLinks" />

                        @if (User.IsInRole("Admin") || User.Identity.Name == "admin@admin.com")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="UserRolesController" asp-action="Index">Manage Users</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - RaceDay7 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>