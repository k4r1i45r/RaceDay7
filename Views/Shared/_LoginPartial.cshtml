@using Microsoft.AspNetCore.Identity
@using RaceDay7.Models
@using RaceDay7.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Context

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var participant = Context.Participants.FirstOrDefault(p => p.UserId == user.Id);
        string imagePath = participant?.ProfileImagePath ?? "/images/default-avatar.png";

        <li class="nav-item">
            <a class="nav-link text-dark d-flex align-items-center" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                <img src="@imagePath" class="rounded-circle me-2" width="32" height="32" style="object-fit:cover;" alt="Profile" />
                <span>Hello @(participant?.FirstName ?? user.UserName)!</span>
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>
