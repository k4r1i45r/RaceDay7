@using RaceDay7.Models
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
    </li>

    @if (User.IsInRole(Roles.Participant))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Enrolments" asp-action="My">My Enrolments</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Results" asp-action="My">My Results</a>
        </li>
    }
}