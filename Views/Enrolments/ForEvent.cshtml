@using RaceDay7.Models
@model IEnumerable<Enrolment>
@{
    var ev = (Event)ViewBag.Event;
    ViewData["Title"] = $"Enrolments - {ev.Name}";
}

<partial name="_Alerts" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Enrolments: @ev.Name</h1>
    <a asp-controller="Results" asp-action="Capture" asp-route-eventId="@ev.Id" class="btn btn-primary">Capture results</a>
</div>
<p class="text-muted">@Model.Count() participant(s) enrolled</p>

@if (Model.Any())
{
    <table class="table align-middle table-hover shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Participant</th>
                <th>Gender</th>
                <th>Category</th>
                <th>Enrolled on</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Participant?.FirstName @e.Participant?.LastName</td>
                    <td>@e.Participant?.Gender</td>
                    <td>@e.Category?.Name</td>
                    <td>@e.EnrolledOn.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (e.Status == "Confirmed")
                        {
                            <span class="status-badge status-confirmed">Confirmed</span>
                        }
                        else
                        {
                            <span class="status-badge status-pending">Pending</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (e.Status != "Confirmed")
                        {
                            <form asp-action="Approve" asp-route-id="@e.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-outline-secondary">Back to event</a>
