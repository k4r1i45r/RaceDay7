@model IEnumerable<RaceDay7.Models.Enrolment>
@{
    ViewData["Title"] = "My Enrolments";
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1 class="h2 fw-bold" style="color: var(--race-black);">My Enrolments</h1>
    <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">Browse More Events</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info border-0 shadow-sm" style="background-color: var(--race-blue); color: var(--race-black);">
        You haven't entered any events yet. <a asp-controller="Events" asp-action="Index" class="alert-link text-dark text-decoration-underline">Browse events</a>.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Result</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="text-decoration-none" style="color: var(--race-grey);">
                                    @e.Event?.Name
                                </a>
                            </td>
                            <td>@e.Event?.Date.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><span class="badge" style="background-color: var(--race-sage); color: var(--race-black);">@e.Category?.Name</span></td>
                            <td>
                                @if (e.Result != null)
                                {
                                    <span class="fw-bold">@e.Result.FinishTime.ToString(@"hh\:mm\:ss")</span>
                                    <span class="text-muted">(@e.Result.Position)</span>
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (e.Result == null && e.Event!.Date > DateTime.Now)
                                {
                                    <form asp-action="Withdraw" asp-route-id="@e.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to withdraw from this event?');">
                                        <button class="btn btn-sm btn-outline-danger">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}