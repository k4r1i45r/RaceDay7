@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h1>Organiser Dashboard</h1>
    <p>Welcome, Organiser! Here you can manage your events.</p>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Events API</div>
                <div class="card-body">
                    <h5 class="card-title">Manage Events</h5>
                    <p class="card-text">Create, edit, and delete events using the API.</p>
                    <a href="/swagger" target="_blank" class="btn btn-light">Open Swagger</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Enrollments</div>
                <div class="card-body">
                    <h5 class="card-title">View Enrollments</h5>
                    <p class="card-text">See who has entered your events.</p>
                    <a href="#" class="btn btn-light">View Enrollments</a>
                </div>
            </div>
        </div>
    </div>
</div>