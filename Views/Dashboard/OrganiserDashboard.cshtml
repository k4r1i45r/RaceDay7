@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 style="color: #08090A;">Organiser Dashboard</h1>
        <p class="lead" style="color: #818479;">Welcome, Organiser! Manage your events and participants here.</p>
        <hr style="border-color: #B5CBB7;" />
    </div>

    <div class="row justify-content-center">
        <!-- Manage Events Card -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm" style="border: 2px solid #B5CBB7; background-color: #E4E9B2;">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title" style="color: #08090A;">Manage Events</h4>
                    <p class="card-text" style="color: #08090A;">Create, edit, and delete events using the API.</p>
                    <a href="/swagger" target="_blank" class="btn mt-auto" style="background-color: #818479; color: white;">Open Swagger API</a>
                </div>
            </div>
        </div>

        <!-- View Enrollments Card -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm" style="border: 2px solid #B5CBB7; background-color: #D2E4C4;">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title" style="color: #08090A;">Enrollments</h4>
                    <p class="card-text" style="color: #08090A;">View participants enrolled in your events.</p>
                    <a href="/swagger" target="_blank" class="btn mt-auto" style="background-color: #818479; color: white;">View Enrollments</a>
                </div>
            </div>
        </div>
    </div>
</div>