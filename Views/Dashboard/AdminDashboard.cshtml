@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 style="color: #08090A;">Admin Dashboard</h1>
        <p class="lead" style="color: #818479;">Welcome, Admin! You have full access to the RaceDay system.</p>
        <hr style="border-color: #B5CBB7;" />
    </div>

    <div class="row justify-content-center">
        <!-- Manage User Roles Card -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm" style="border: 2px solid #B5CBB7; background-color: #E4E9B2;">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title" style="color: #08090A;">User Management</h4>
                    <p class="card-text" style="color: #08090A;">View all registered users and assign them roles (Organiser or Participant).</p>
                    <a asp-controller="UserRoles" asp-action="Index" class="btn mt-auto" style="background-color: #818479; color: white;">Manage User Roles</a>
                </div>
            </div>
        </div>

        <!-- API / Events Card -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm" style="border: 2px solid #B5CBB7; background-color: #D2E4C4;">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title" style="color: #08090A;">System Events</h4>
                    <p class="card-text" style="color: #08090A;">View and manage all events, categories, and results via the API.</p>
                    <a href="/swagger" target="_blank" class="btn mt-auto" style="background-color: #818479; color: white;">Open Swagger API</a>
                </div>
            </div>
        </div>
    </div>
</div>